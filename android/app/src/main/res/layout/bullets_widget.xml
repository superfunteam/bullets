<?xml version="1.0" encoding="utf-8"?>
<!-- @android:id/background on the root is what enables the smooth Android 12+
     launcher transition. Padding is generous because corner masking is applied
     automatically and clips anything sitting near the corners. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:theme="@style/BulletsWidgetTheme">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="–" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="3dp"
                android:layout_gravity="bottom"
                android:textColor="@color/widget_ink_2"
                android:textSize="13sp"
                android:text="@string/widget_shots_today" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:textColor="@color/widget_ink_2"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:ellipsize="end"
            android:maxLines="4" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:textColor="@color/widget_button_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="@string/widget_add" />
</LinearLayout>
